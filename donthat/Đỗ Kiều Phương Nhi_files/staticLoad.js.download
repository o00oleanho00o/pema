async function JSStatic_Seq(arr,finalCallback,options={}) {
    if(!Array.isArray(arr)) arr=[arr];
    try {
        for(let url of arr) {
            await new Promise((resolve,reject) => {
                JSStatic(url,(err) => {
                    if(err) {
                        reject(err);
                    } else {
                        resolve();

                    }
                },options);
            });
        }
        if(typeof finalCallback==='function') finalCallback(null);
    } catch(err) {
        if(typeof finalCallback==='function') finalCallback(err);
    }
}
function JSStatic_Async(arr,finalCallback,options={}) {
    if(!Array.isArray(arr)) arr=[arr];
    const promises=arr.map(url => {
        return new Promise((resolve,reject) => {
            JSStatic(url,(err) => {
                if(err) reject(err);
                else resolve();
            },options);
        });
    });

    Promise.all(promises)
        .then(() => {
            if(typeof finalCallback==='function') finalCallback(null);
        })
        .catch((err) => {
            if(typeof finalCallback==='function') finalCallback(err);
        });
}
//#endregion