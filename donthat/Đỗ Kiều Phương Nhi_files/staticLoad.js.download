
ver_check();

//#region // Convert url
const VD_ISDEV=author_get('Minify')==1? true:false;
const VDDEVSET=(() => {
    try {
        const raw=localstorage_get("DevEnviroment");
        const parsed=raw? JSON.parse(raw):{};
        return parsed.data||{};
    } catch(e) {
        return {};
    }
})();
const STL_ISMIN=(() => {
    try {
        if(VD_ISDEV) {
            if(VDDEVSET.IsMin) return true;
            else return false;
        }
        else return true
    } catch(e) {
        return true;
    }
})();
const STL_ISCDN=(() => {
    try {
        const cdnEnabled=typeof VDCDN!=='undefined'&&VDCDN==='1';
        const cdnUrl=typeof VDCDN_URL!=='undefined'? VDCDN_URL.trim().replace(/\/$/,''):'';
        if(((!VD_ISDEV&&cdnEnabled)||(VD_ISDEV&&VDDEVSET.IsCdn) )&&cdnUrl!='') return true;
        else return false;


    } catch(e) {
        return false;
    }
})();
const STL_ISCACHE=(() => {
    try {

        if(VD_ISDEV) {
            if(!VDDEVSET.IsBlockCache) return true;
            else return false;
        }
        else return true
    } catch(e) {
        return true;
    }
})();
const STL_CACHEVER=(() => {
    try {

        const name=typeof VDNAME!=='undefined'
            ? VDNAME.toLowerCase().replace(/ /g,'')
            :'app';
        const verExtent=ver_get();
        const shortTime=new Date().getTime().toString().slice(-6);
        if(STL_ISCACHE) {
            return `${name}${verExtent}`;
        }
        else {
            return `${name}${verExtent}[${shortTime}]`;
        }

    } catch(e) {
        return '';
    }
})();
function sl_getmin(url) {
    try {

        if(STL_ISMIN) {
            if(!url.includes('/assests/')&&!url.includes('/assets/')) {
                if(url.includes('.js')&&!url.includes('.min.js')) {
                    url=url.replace('.js','.min.js');
                }
                else if(url.includes('.css')&&!url.includes('.min.css')) {
                    url=url.replace('.css','.min.css');
                }
            }
        }
        return url;
    }
    catch(ex) {
        return url;
    }
}
function sl_getcdn(url) {
    try {

        if(STL_ISCDN) {
            url=url.startsWith('/')? VDCDN_URL+url:url;
        }
        return url;

    }
    catch(ex) {
        return url;
    }
}
function sl_getcache(url) {
    try {

        const hasQuery=url.includes("?");
        url=url+(hasQuery? "&":"?")+"ver="+STL_CACHEVER;
        return url;
    }
    catch(ex) {
        return url;
    }
}
function static_log(ex) {

    if(VD_ISDEV) {
        // console.log(ex)
    }
}
function StaticLink_Convert(path) {
    try {

        return sl_getcache(sl_getcdn(sl_getmin(path)));
    }
    catch(ex) {
        return path;
    }
}
//#endregion

//#region // Delay,resume ready
function Static_delayReady() {
    if(window._readyHooked) return;
    window._readyQueue=[];
    window._originalReady=jQuery.fn.ready;

    jQuery.fn.ready=function(fn) {
        window._readyQueue.push(fn);
        return this;
    };

    window._readyHooked=true;
}
function Static_resumeReady() {
    const queue=window._readyQueue||[];
    for(let i=0;i<queue.length;i++) {
        try {
            queue[i](jQuery);
        } catch(e) {
            console.error("Error in ready():",e);
        }
    }

    if(window._originalReady) {
        jQuery.fn.ready=window._originalReady;
    }
    window._readyQueue=[];
    window._readyHooked=false;
}
//#endregion

//#region // CSS
function CSSStatic(urls) {
    try {
        if(!Array.isArray(urls)) urls=[urls];
        urls.forEach(url => {
            const finalUrl=StaticLink_Convert(url);
            $('head').append(
                $('<link rel="stylesheet" type="text/css" />').attr('href',finalUrl)
            );
        });
    } catch(ex) {
        static_log('[css]Fail: '+(Array.isArray(urls)? urls.join(', '):urls));
    }
}
//#endregion

//#region // JS


//Old
function JSStatic_BlockUI(url,async=false) {
    url=StaticLink_Convert(url);

    try {
        jQuery.ajax({
            url: url,
            dataType: 'script',
            async: async,
            cache: true,
            success: function(data) {
                static_log('[js]async:'+async+':'+url)
            },
            error: function() {
                static_log('[js]Fail:'+url);
            }
        });
    }
    catch(ex) {
        static_log('[js]Fail:'+url);
    }
}
//Old
function JSStatic_Normal(urls) {
    if(!Array.isArray(urls)) urls=[urls];
    for(let url of urls) {

        JSStatic_BlockUI(url,false);
    }
}
function JSStatic(url,callback,options={}) {

    options=options||{};
    const finalUrl=StaticLink_Convert(url);

    jQuery.ajax({
        url: finalUrl,
        dataType: 'script',
        cache: true,
        success: function() {
            if(typeof callback==='function') callback(null,finalUrl);
        },
        error: function() {
            if(typeof callback==='function') callback(new Error('Failed to load: '+finalUrl));
        }
    });

    //options=options||{};
