//#endregion
function serworker_ini(files = [], version = 'v1', name = 'cache', onDone) {
    if (!('serviceWorker' in navigator)) {
        alert('Trình duyệt của bạn không hỗ trợ Service Worker. Vui lòng dùng trình duyệt mới hơn.');
        return;
    }

    files = files.map(f => StaticLink_Convert(f));
    navigator.serviceWorker.register('/sw2.js').then((reg) => {
        navigator.serviceWorker.addEventListener('message', (event) => {
            if (event.data?.type === 'CACHE_DONE') {
                static_log('Cache xong version:', event.data.version);
                onDone?.();
            }
        });

        const message = {
            type: 'INIT_CACHE',
            payload: {
                files,
                version,
                VD_ISDEV,
                name
            }
        };

        const sendToWorker = (worker) => {
            if (worker?.state === 'activated') {
                worker.postMessage(message);
            } else {
                worker.addEventListener('statechange', () => {
                    if (worker.state === 'activated') {
                        worker.postMessage(message);
                    }
                });
            }
        };

        if (reg.active) {
            sendToWorker(reg.active);
        } else {
            navigator.serviceWorker.ready.then((readyReg) => {
                if (readyReg.active) {
                    sendToWorker(readyReg.active);
                }
            });
        }
    }).catch((err) => {
        static_log('Lỗi khi đăng ký service worker:', err);
        static_log('Không thể đăng ký Service Worker. Hãy thử tải lại trang hoặc kiểm tra trình duyệt.');
    });
}