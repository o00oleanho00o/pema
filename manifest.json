{
  "manifest_version": 3,
  "name": "Prescription Splitter",
  "version": "1.3.3",
  "description": "Reads a visible clinic prescription, matches a local catalog, and splits local print previews.",
  "permissions": [
    "scripting",
    "storage"
  ],
  "host_permissions": [
    "https://annam.vttechsolution.vn/*"
  ],
  "icons": {
    "16": "assets/extension-icon-16.png",
    "32": "assets/extension-icon-32.png",
    "48": "assets/extension-icon-48.png",
    "128": "assets/extension-icon-128.png"
  },
  "action": {
    "default_icon": {
      "16": "assets/extension-icon-16.png",
      "32": "assets/extension-icon-32.png"
    },
    "default_title": "PEMA - Tách đơn thuốc",
    "default_popup": "popup.html"
  },
  "options_page": "options.html"
}
